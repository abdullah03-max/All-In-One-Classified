<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>All In One</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.allinone.classified</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>All In One</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- App Privacy Descriptions -->
	<key>NSCameraUsageDescription</key>
	<string>All In One needs camera access so you can capture photos of your items for listing and CNIC verification.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>All In One needs photo library access to upload item photos and profile images.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>All In One needs microphone access to record audio voice notes in chat.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>All In One uses your location to discover nearby marketplace listings and set item location.</string>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Supabase OAuth Deep Link URL Schemes -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.allinone.classified.all-in-one-classified-app</string>
				<string>allinoneclassified</string>
				<string>io.supabase.flutterquickstart</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
